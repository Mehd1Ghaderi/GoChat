# Registry prefix for every image, with its trailing slash.
DOCKER_REGISTRY=docker.io/

CONFIG_ENV_PREFIX=
CONFIG_PATH=config

# Scylla: an admin role for setup and migrations, and the app's role, which
# may only read and write its keyspace. Role names: a-z, 0-9 and _.
DATABASE_SCYLLA_ADMIN_USERNAME=<string>
DATABASE_SCYLLA_ADMIN_PASSWORD=<string>
DATABASE_SCYLLA_USERNAME=<string>
DATABASE_SCYLLA_PASSWORD=<string>
# MinIO: its root account, and the app's account, limited to its bucket.
MINIO_ROOT_USER=<string>
MINIO_ROOT_PASSWORD=<string>
STORAGE_MINIO_ACCESS_KEY=<string>
STORAGE_MINIO_SECRET_KEY=<string>

# Shared by the server and its web gateways: at least 32 characters.
GATEWAY_KEY=<string>
# Seals TOTP secrets at rest: `openssl rand -base64 32`.
SERVICES_ACCOUNTS_SECRET_KEY=<base64 32 bytes>
# Required to create the first (admin) account: without it no account can
# be created. `openssl rand -hex 24`; it is not needed once that account exists.
SERVICES_ACCOUNTS_SETUP_TOKEN=

# The origin browsers use; https behind a TLS-terminating proxy or tunnel.
WEB_PUBLIC_URL=http://localhost:8080
# Where the web gateway listens on the host. 127.0.0.1 accepts only this
# machine, e.g. a reverse proxy or tunnel; 0.0.0.0 accepts everyone.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Behind a proxy on the host, the addresses its requests come from, so rate
# limits see clients: 172.16.0.0/12 covers Docker's default networks.
WEB_TRUSTED_PROXIES=
