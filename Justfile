set dotenv-load := true
set shell := ["bash", "-euo", "pipefail", "-c"]

module          := "github.com/ssenerg/gochat"
version         := "v0.1.0"
app_name        := "gochat"
app_name_pretty := "GoChat"
ldflags_id      := "-X '" + module + "/internal.appName=" + app_name + "' -X '" + module + "/internal.appNamePretty=" + app_name_pretty + "' -X '" + module + "/internal.version=" + version + "'"
ldflags         := "-s -w " + ldflags_id
bin_dir         := "./.bin"
compose_file    := "deployments/docker/docker-compose.yml"
compose_dev     := "deployments/docker/docker-compose.dev.yml"
compose         := "docker compose --env-file .env -f " + compose_file
compose_devenv  := compose + " -f " + compose_dev

# List the recipes.
default:
    @just --list

# Print the build's name and version.
version: build
    @{{bin_dir}}/{{app_name}} version

# Build the binary.
build: generate
    @go build -trimpath -ldflags "{{ldflags}}" -o {{bin_dir}}/{{app_name}} ./cmd/gochat

# Run the chat server on the host, against the dev stores.
server: _require_env build
    @SERVER_DRPC_GATEWAY_KEY="$GATEWAY_KEY" {{bin_dir}}/{{app_name}} server

# Run the web gateway on the host.
web: _require_env build
    @CLIENT_DRPC_GATEWAY_KEY="$GATEWAY_KEY" {{bin_dir}}/{{app_name}} web

# Run the voice server on the host.
voice: _require_env build
    @CLIENT_DRPC_GATEWAY_KEY="$GATEWAY_KEY" {{bin_dir}}/{{app_name}} voice

# Apply the scylla migrations (dev stores).
# Migrations run as the database's admin role; the app's role cannot change
# the schema.
migrate: _require_env build
    @DATABASE_SCYLLA_USERNAME="$DATABASE_SCYLLA_ADMIN_USERNAME" DATABASE_SCYLLA_PASSWORD="$DATABASE_SCYLLA_ADMIN_PASSWORD" \
        {{bin_dir}}/{{app_name}} migrate scylla up ./migrations/scylla

# Show the applied and pending scylla migrations.
migrate-status: _require_env build
    @DATABASE_SCYLLA_USERNAME="$DATABASE_SCYLLA_ADMIN_USERNAME" DATABASE_SCYLLA_PASSWORD="$DATABASE_SCYLLA_ADMIN_PASSWORD" \
        {{bin_dir}}/{{app_name}} migrate scylla status ./migrations/scylla

# Start scylla and minio, published on the host for local runs.
stores: _require_env
    @{{compose_devenv}} up -d scylla minio
    @{{compose_devenv}} up scylla-init minio-init

# Stop the dev stores.
stores-down:
    @{{compose_devenv}} stop scylla minio

# Build the image and run the whole stack in docker.
up: _require_env generate
    @{{compose}} up -d --build

# Stop the stack.
down:
    @{{compose}} down

# Stop the stack and drop its volumes.
downv:
    @{{compose}} down -v

# Follow the logs of a service: just logs web
logs service:
    @{{compose}} logs -f {{service}}

# Show the stack's containers.
ps:
    @{{compose}} ps

# Build the image.
image: generate
    @docker build --build-arg DOCKER_REGISTRY="${DOCKER_REGISTRY:-docker.io/}" -t {{app_name}}:latest -f deployments/docker/Dockerfile .

# Deploy a published image on a server, signed in as its admin (sudo asks for
# the password): just deploy admin@host [latest|sha-COMMIT]
deploy target tag="latest" image="ghcr.io/ssenerg/gochat" path="/opt/apps/gochat":
    @digest=$(docker buildx imagetools inspect "{{image}}:{{tag}}" --format '{{{{.Manifest.Digest}}') && \
        ssh -t {{target}} "sudo -u deploy '{{path}}/deploy.sh' '{{image}}' $digest"

# Regenerate the protobuf code and the Dockerfile.
generate: _assert_version proto dockerfile

# Lint and generate the protobuf code.
proto:
    @buf lint
    @buf generate

dockerfile:
    @{ echo "# This file is auto-generated by the Justfile. Do not edit manually."; echo; \
       sed -e "s|{{{{LDFLAGS}}|{{ldflags}}|g" deployments/docker/Dockerfile.template; } > deployments/docker/Dockerfile

# Lint with the version CI uses.
lint:
    @go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 run --fix

test:
    @go test ./...

test-race:
    @go test -race -count=1 ./...

tidy:
    @go mod tidy

# Everything a commit should pass.
pre-commit: generate tidy lint test

clean:
    @rm -rf {{bin_dir}}

_require_env:
    @if [ ! -f ./.env ]; then echo "No .env file found: copy .env.template" >&2; exit 1; fi

_assert_version:
    @if ! echo "{{version}}" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then \
        echo "version '{{version}}' is not a valid semver" >&2; exit 1; fi
